# Copy to .env and fill in. .env is gitignored.

# Gemini API key (https://aistudio.google.com/apikey)
GEMINI_API_KEY=

# Optional: override default models from config/config.py
# ACTOR_MODEL=gemini-3.6-flash
# CRITIC_MODEL=gemini-3.6-flash
# JUDGE_MODEL=gemini-3.6-flash      # use a DIFFERENT family if possible (reduces self-bias)
# NOTE: gemini-2.5-* returns 404 'no longer available to new users' on newly
# created projects. Existing projects keep access; new ones must use 3.x.
